[Unit]
Description=Telegram-бот «Матрица Судьбы»
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matrixbot
WorkingDirectory=/opt/matrix-bot
# Миграции перед каждым стартом; бэкап базы делает scripts/premigrate_backup.py
ExecStartPre=/opt/matrix-bot/.venv/bin/python scripts/premigrate_backup.py
ExecStartPre=/opt/matrix-bot/.venv/bin/alembic upgrade head
ExecStart=/opt/matrix-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
# Токен лежит только в /opt/matrix-bot/.env (chmod 600)
EnvironmentFile=/opt/matrix-bot/.env

[Install]
WantedBy=multi-user.target
